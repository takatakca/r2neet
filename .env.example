# R2NETTE — copy to .env and fill in. Never commit real values.
DATABASE_URL=

# Twilio Verify — phone identity (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Twilio Voice — callback dialling
TWILIO_VOICE_NUMBER=

# Google Places (New) + Routes — address autocomplete and authoritative distance
GOOGLE_MAPS_API_KEY=

# Google Business Profile — live review sync
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Stripe — payments, wallets, saved cards
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI concierge (optional — guided buttons work without it)
AI_PROVIDER=
AI_PROVIDER_API_KEY=

# Separate test database. Never equal to DATABASE_URL.
# Tests refuse to run if this is unset — there is no fallback.
TEST_DATABASE_URL=
PRISMA_DATABASE_URL=

# R2NETTE dispatch origin for travel distance. Server-only — the browser
# must never receive the business street address.
BUSINESS_ORIGIN_LAT=
BUSINESS_ORIGIN_LNG=
PORT=3000

# AI concierge (optional — guided actions work without it)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Public base URL for Twilio voice callbacks
PUBLIC_URL=

# Staff accounts are created with `npm run staff:create`.
# There is deliberately no ADMIN_TOKEN: a shared secret cannot be revoked per
# person and leaves no usable audit trail.

# Notifications (optional). Unconfigured channels record SUPPRESSED and are
# never reported as sent.
TWILIO_SMS_NUMBER=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Encrypts two-factor secrets at rest. 32+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Losing this key locks every 2FA account out — store it with your other secrets.
FIELD_ENCRYPTION_KEY=

# Previous encryption keys, comma-separated. Keep them here only until
# `npm run security:rotate-key -- --apply` reports remaining: 0.
FIELD_ENCRYPTION_KEYS_RETIRED=
BACKUP_DIR=backups

# Automated backup
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=7
# Off-host copy. Without this the backup dies with the machine.
BACKUP_S3_BUCKET=

# Off-host backup storage. Any S3-compatible provider: AWS, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_PREFIX=r2nette

# Where critical operational alerts go. Any endpoint accepting a POST.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
WORKER_STARTUP_GRACE_MINUTES=15
