{
  "name": "@r2nette/pricing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "R2NETTE authoritative reservation pricing & quote engine",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "vite-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "dev:api": "vite-node src/api/server.ts",
    "build": "vite build",
    "build:single": "SINGLE_FILE=1 vite build",
    "dev": "vite web",
    "start": "vite-node src/api/server.ts",
    "staff:create": "vite-node scripts/create-staff.ts --",
    "worker:recurrence": "vite-node scripts/recurrence-worker.ts",
    "worker:billing": "vite-node scripts/billing-worker.ts",
    "worker:maintenance": "vite-node scripts/maintenance-worker.ts",
    "security:rotate-key": "vite-node scripts/rotate-key.ts --",
    "db:backup": "vite-node scripts/backup.ts",
    "loop:billing": "vite-node scripts/loop-billing.ts",
    "loop:scheduler": "vite-node scripts/loop-scheduler.ts",
    "loop:backup": "vite-node scripts/loop-backup.ts",
    "migrate:setmore": "vite-node scripts/import-setmore.ts --",
    "drill:restore": "vite-node scripts/restore-drill.ts",
    "ci": "npx tsc --noEmit && npm run build && npx vitest run",
    "test:invariants": "vitest run --reporter=json --outputFile=/tmp/vitest-results.json && vite-node scripts/check-invariants.ts -- /tmp/vitest-results.json"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "stripe": "^22.6.0",
    "supertest": "^7.2.2",
    "zod": "^3.23.8"
  }
}